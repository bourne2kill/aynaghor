# AYNAGH0R Configuration
# Copy this file to .env and configure your settings

# =============================================================================
# LLM Provider Configuration
# =============================================================================

# Choose your AI provider: true for Gemini, false for Local AI
USE_GEMINI=true

# Google Gemini Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Local AI Configuration (if USE_GEMINI=false)
LLM_HOST=http://localhost:8080
LLM_MODEL=llama2-7b-chat

# =============================================================================
# Application Settings
# =============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true

# Streamlit Configuration
STREAMLIT_PORT=8501
STREAMLIT_HOST=0.0.0.0

# =============================================================================
# Story Generation Settings
# =============================================================================

# Default story parameters
DEFAULT_STORY_LENGTH=medium
DEFAULT_GENRE=dark_fantasy
DEFAULT_MOOD=mysterious

# Content filtering
ENABLE_CONTENT_FILTER=true
MAX_STORY_LENGTH=2000

# =============================================================================
# Voice Module Settings (Future)
# =============================================================================

# Voice recognition service
VOICE_PROVIDER=whisper
WHISPER_MODEL=base

# Text-to-speech settings
TTS_PROVIDER=elevenlabs
TTS_VOICE_ID=your_voice_id_here

# =============================================================================
# Image Generation Settings (Future)
# =============================================================================

# Image generation provider
IMAGE_PROVIDER=stable_diffusion
SD_API_URL=http://localhost:7860

# =============================================================================
# Security & Rate Limiting
# =============================================================================

# API rate limiting
MAX_REQUESTS_PER_MINUTE=10
MAX_TOKENS_PER_DAY=15000

# Session management
SESSION_TIMEOUT=3600
MAX_CONCURRENT_SESSIONS=100

# =============================================================================
# Logging & Monitoring
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
LOG_FILE=logs/aynaghor.log

# Enable metrics collection
ENABLE_METRICS=true
METRICS_PORT=9090