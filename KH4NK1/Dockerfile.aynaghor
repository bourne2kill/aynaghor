FROM python:3.11-slim

WORKDIR /app

# Install runtime dependencies (the requirements generated by the agent)
COPY workspace/aynaghor/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the generated source code
COPY workspace/aynaghor/ .

EXPOSE 8501

CMD ["streamlit", "run", "ui/app.py", "--server.port", "8501", "--server.enableCORS", "false"]